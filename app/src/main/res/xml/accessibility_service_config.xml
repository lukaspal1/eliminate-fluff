<?xml version="1.0" encoding="utf-8"?>
<!-- No packageNames filter: the service needs to see when you leave Instagram/YouTube
     so it can remove the tab cover. It ignores every other app. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="50" />
